{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "build-server",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "sourceMap": true
  }
}
