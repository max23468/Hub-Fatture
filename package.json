{
  "name": "hub-fatture",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "aruba:api:probe": "node scripts/aruba-api-read-probe.ts",
    "aruba:api:probe:interactive": "sh scripts/aruba-api-read-probe.sh",
    "aruba:api:probe:keychain": "sh scripts/aruba-api-read-probe-keychain.sh",
    "build": "react-router build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run check:full",
    "check:docs": "node --test scripts/change-impact.test.mjs scripts/prepare-production-release.node-test.mjs scripts/publish-preflight.node-test.mjs scripts/repository-content.node-test.mjs",
    "check:standard": "npm run toolchain:check && npm run format:check && npm run lint && npm run typecheck && npm run build:server && npm run test:unit && npm run smoke:imports && npm run smoke:type-stripping && npm run build",
    "check:full": "npm run check:standard && npm run audit && npm run test:db && npm run test:provider && npm run doctor && npm run test:e2e",
    "db:migrate": "npm run build:server && node build-server/db/migrate.js",
    "dev": "react-router dev",
    "dev:up": "sh scripts/development.sh",
    "dev:worker": "node --watch src/worker.ts",
    "doctor": "react-doctor --scope full --blocking warning .",
    "email:qualification": "node build-server/operations/email-delivery-qualification.js",
    "fiscal-profile:activate": "node scripts/activate-fiscal-profile.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "preflight:provider": "node scripts/provider-preflight.mjs",
    "publish:preflight": "node scripts/publish-preflight.mjs",
    "smoke:imports": "node scripts/dependency-smoke.mjs",
    "smoke:type-stripping": "node scripts/type-stripping-smoke.ts",
    "start": "react-router-serve ./build/server/index.js",
    "start:worker": "node build-server/worker.js",
    "test": "node --test",
    "test:db": "node scripts/with-test-database.mjs npm run test:db:direct",
    "test:db:direct": "node --test --test-concurrency=4 src/db/*.test.ts",
    "test:provider": "node --test src/integrations/*.test.ts",
    "test:unit": "node --test app/*.test.ts src/*.test.ts scripts/*.node-test.mjs scripts/*.test.mjs",
    "test:e2e": "npm run build && node scripts/with-test-database.mjs npm run test:e2e:direct",
    "test:e2e:chromium": "npm run build && node scripts/with-test-database.mjs npm run test:e2e:chromium:direct",
    "test:e2e:chromium:direct": "playwright test --project=chromium --workers=1",
    "test:e2e:direct": "npm run test:e2e:chromium:direct && npm run test:e2e:webkit:direct",
    "test:e2e:release-candidate": "npm run build && node scripts/with-test-database.mjs npm run test:e2e:direct",
    "test:e2e:webkit": "npm run build && node scripts/with-test-database.mjs npm run test:e2e:webkit:direct",
    "test:e2e:webkit:direct": "playwright test --project=webkit --workers=1",
    "toolchain:check": "node scripts/toolchain-policy.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "worktree:create": "sh scripts/create-worktree.sh",
    "worktree:dependencies": "sh scripts/worktree-dependencies.sh"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@shopify/shopify-api": "14.0.0",
    "lucide-react": "1.34.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "xmlbuilder2": "4.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@shopify/cli": "4.7.0",
    "@types/node": "26.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "react-doctor": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
