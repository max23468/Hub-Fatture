{
  "name": "hub-fatture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run smoke:imports && npm run smoke:type-stripping && npm run build && npm run test:e2e",
    "dev": "react-router dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "preflight:provider": "node scripts/provider-preflight.mjs",
    "smoke:imports": "node scripts/dependency-smoke.mjs",
    "smoke:type-stripping": "node scripts/type-stripping-smoke.ts",
    "start": "react-router-serve ./build/server/index.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@shopify/shopify-api": "13.1.0",
    "nodemailer": "9.0.4",
    "otpauth": "9.5.1",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "xmlbuilder2": "4.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "26.1.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-plugin-react-doctor": "0.9.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "engines": {
    "node": "26.5.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
