{
  "name": "hub-fatture",
  "version": "0.3.18",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "aruba:helper": "node scripts/aruba-helper.ts",
    "build": "react-router build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run check:full",
    "check:docs": "node --test scripts/change-impact.test.mjs scripts/codex-review-gate.test.mjs scripts/repository-content.node-test.mjs",
    "check:standard": "npm run toolchain:check && npm run format:check && npm run lint && npm run typecheck && npm run build:server && npm run test:unit && npm run smoke:imports && npm run smoke:type-stripping && npm run build",
    "check:full": "npm run check:standard && npm run audit && npm run test:db && npm run test:provider && npm run doctor && npm run test:e2e",
    "db:migrate": "npm run build:server && node build-server/db/migrate.js",
    "dev": "react-router dev",
    "dev:shopify": "sh scripts/development.sh shopify",
    "dev:shopify:cli": "npm exec -- @shopify/cli app dev --no-color",
    "dev:up": "sh scripts/development.sh",
    "dev:worker": "node --watch src/worker.ts",
    "doctor": "react-doctor --scope full --blocking warning .",
    "fiscal-profile:activate": "node scripts/activate-fiscal-profile.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "preflight:provider": "node scripts/provider-preflight.mjs",
    "smoke:imports": "node scripts/dependency-smoke.mjs",
    "smoke:type-stripping": "node scripts/type-stripping-smoke.ts",
    "start": "react-router-serve ./build/server/index.js",
    "start:worker": "node build-server/worker.js",
    "test": "node --test",
    "test:db": "node --test --test-concurrency=4 src/db/*.test.ts",
    "test:provider": "node --test src/integrations/*.test.ts",
    "test:unit": "node --test app/*.test.ts src/*.test.ts scripts/*.node-test.mjs scripts/*.test.mjs",
    "test:aruba:platform": "node scripts/aruba-helper-platform-check.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:release-candidate": "playwright test --project=chromium && playwright test --project=webkit",
    "toolchain:check": "node scripts/toolchain-policy.mjs",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@shopify/shopify-api": "13.1.0",
    "lucide-react": "1.30.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "xmlbuilder2": "4.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@shopify/cli": "4.6.0",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "react-doctor": "0.9.11",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
