{
  "name": "hub-fatture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "build": "react-router build",
    "build:server": "tsc -p tsconfig.server.json",
    "check": "npm run toolchain:check && npm run audit && npm run format:check && npm run lint && npm run typecheck && npm run build:server && npm test && npm run smoke:imports && npm run smoke:type-stripping && npm run doctor && npm run build && npm run test:e2e",
    "db:migrate": "npm run build:server && node build-server/db/migrate.js",
    "dev": "react-router dev",
    "doctor": "react-doctor",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "preflight:provider": "node scripts/provider-preflight.mjs",
    "smoke:imports": "node scripts/dependency-smoke.mjs",
    "smoke:type-stripping": "node scripts/type-stripping-smoke.ts",
    "start": "react-router-serve ./build/server/index.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "toolchain:check": "node scripts/toolchain-policy.mjs",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "lucide-react": "1.30.0",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "react-doctor": "0.9.11",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": "26.7.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
